@page "/reports"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Globalization
@using System.IO
@using System.Text
@using Microsoft.Extensions.Logging
@using SmartPark.Services
@using SmartPark.Models
@inject ParkingRecordService RecordService
@inject ILogger<Reports> Logger

<PageTitle>Parking Reports - SmartPark</PageTitle>

<div class="page-header">
    <div>
        <div class="page-eyebrow">
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Small" />
            Insights
        </div>
        <h1 class="page-title">Parking reports</h1>
        <p class="page-subtitle">Review completed sessions with clean operational metrics and export-ready detail.</p>
    </div>
    <div class="page-actions">
        <div class="btn-group" role="group">
                <button class="btn btn-success" @onclick="ExportReport"
                    disabled="@(summary.CompletedCount == 0 || isExporting)">
                <MudIcon Icon="@Icons.Material.Filled.IosShare" Size="Size.Small" />
                @(isExporting ? "Exporting..." : "Export Overall CSV")
            </button>
            <button class="btn btn-outline-success" @onclick="ExportByVehicleSummary"
                    disabled="@(summary.CompletedCount == 0 || isExporting)">
                <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" />
                Export By Vehicle
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(exportMessage))
{
    <div class="alert @(exportSucceeded ? "alert-success" : "alert-danger") mb-3" role="alert">
        <MudIcon Icon="@(exportSucceeded ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.ErrorOutline)"
                 Size="Size.Small" />
        <span class="ms-2">@exportMessage</span>
    </div>
}

<div class="grid-3 mb-4">
    <div class="stats-card primary">
        <div class="stats-top">
            <div class="stats-label">Completed Sessions</div>
            <div class="stats-icon">
                <MudIcon Icon="@Icons.Material.Filled.TaskAlt" />
            </div>
        </div>
        <div class="stats-number">@summary.CompletedCount</div>
        <div class="stats-trend">Total recorded exits</div>
    </div>

    <div class="stats-card success">
        <div class="stats-top">
            <div class="stats-label">Average Duration</div>
            <div class="stats-icon">
                <MudIcon Icon="@Icons.Material.Filled.Timer" />
            </div>
        </div>
        <div class="stats-number">@AverageDurationText</div>
        <div class="stats-trend">Across completed sessions</div>
    </div>

    <div class="stats-card info">
        <div class="stats-top">
            <div class="stats-label">Total Duration</div>
            <div class="stats-icon">
                <MudIcon Icon="@Icons.Material.Filled.QueryStats" />
            </div>
        </div>
        <div class="stats-number">@TotalDurationText</div>
        <div class="stats-trend">Accumulated parking time</div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="panel-heading">
            <div>
                <h2 class="section-title">Completed parking sessions</h2>
                <div class="muted-text">Only sessions with entry and exit times are included.</div>
            </div>
            <span class="badge bg-success">@summary.CompletedCount completed</span>
        </div>

        @if (isLoading)
        {
            <div class="empty-state">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <p class="mt-2">Loading report…</p>
            </div>
        }
        else if (completedRecords.Count == 0)
        {
            <div class="empty-state">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Color="Color.Primary" Size="Size.Large" />
                <strong>No completed parking sessions found</strong>
                <p>Reports populate once vehicles are checked out.</p>
            </div>
        }
        else
        {
            <div class="table-shell">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Vehicle Number</th>
                                <th>Owner Name</th>
                                <th>Slot Number</th>
                                <th>Entry Time</th>
                                <th>Exit Time</th>
                                <th>Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < completedRecords.Count; i++)
                            {
                                var record = completedRecords[i];
                                // Row number is relative to the full result set, not just the
                                // current page, so users can cross-reference with the CSV export.
                                var rowNumber = ((currentPage - 1) * currentPageSize) + i + 1;
                                <tr>
                                    <td>@rowNumber</td>
                                    <td><span class="vehicle-plate">@record.VehicleNumber</span></td>
                                    <td>@record.OwnerName</td>
                                    <td><span class="badge bg-primary">Slot @record.ParkingSlot?.SlotNumber</span></td>
                                    <td>@record.EntryTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@record.ExitTime?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@FormatDuration(record.Duration)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <Pager Page="@currentPage"
                   PageSize="@currentPageSize"
                   TotalCount="@summary.CompletedCount"
                   PageChanged="OnPageChanged"
                   PageSizeChanged="OnPageSizeChanged" />
        }
    </div>
</div>

@code {
    // The report now renders from a single completed-record dataset so the
    // table and stats always stay in sync.
    private List<ParkingRecord> allCompletedRecords = new();
    private List<ParkingRecord> completedRecords = new();
    private CompletedRecordsSummary summary = new();

    private int currentPage = 1;
    private int currentPageSize = 25;
    private bool isLoading;

    private bool isExporting;
    private bool exportSucceeded;
    private string? exportMessage;

    private string TotalDurationText =>
        summary.CompletedCount == 0 ? "0h" : FormatDuration(summary.TotalDuration);

    private string AverageDurationText =>
        summary.CompletedCount == 0 ? "0h" : FormatDuration(summary.AverageDuration);

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            allCompletedRecords = await RecordService.GetCompletedRecordsAsync();

            var durations = allCompletedRecords
                .Where(r => r.Duration.HasValue)
                .Select(r => r.Duration!.Value)
                .ToList();

            var total = durations.Count == 0
                ? TimeSpan.Zero
                : durations.Aggregate(TimeSpan.Zero, (acc, d) => acc + d);

            summary = new CompletedRecordsSummary
            {
                CompletedCount = allCompletedRecords.Count,
                TotalDuration = total,
                AverageDuration = durations.Count == 0
                    ? TimeSpan.Zero
                    : TimeSpan.FromTicks(total.Ticks / durations.Count)
            };

            var totalPages = currentPageSize <= 0
                ? 1
                : (int)Math.Ceiling(allCompletedRecords.Count / (double)currentPageSize);

            if (totalPages == 0)
            {
                currentPage = 1;
                completedRecords = new();
            }
            else
            {
                currentPage = Math.Min(currentPage, totalPages);
                currentPage = Math.Max(1, currentPage);
                completedRecords = allCompletedRecords
                    .Skip((currentPage - 1) * currentPageSize)
                    .Take(currentPageSize)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load reports page");
            completedRecords = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPageChanged(int newPage)
    {
        currentPage = newPage;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(int newSize)
    {
        currentPageSize = newSize;
        currentPage = 1;
        await LoadAsync();
    }

    private async Task ExportReport()
    {
        if (summary.CompletedCount == 0 || isExporting)
        {
            return;
        }

        isExporting = true;
        exportMessage = null;
        StateHasChanged();

        try
        {
            // Export must cover the full dataset, not just the currently
            // displayed page, so we re-query the unpaginated list here.
            var csv = BuildCsv(allCompletedRecords);
            var fileName = $"SmartPark-Report-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
            var directory = ResolveExportDirectory();
            Directory.CreateDirectory(directory);
            var fullPath = Path.Combine(directory, fileName);

            // UTF-8 with BOM so Excel on Windows opens it cleanly.
            await File.WriteAllTextAsync(fullPath, csv, new UTF8Encoding(encoderShouldEmitUTF8Identifier: true));

            Logger.LogInformation("Exported parking report ({Count} rows) to {Path}", allCompletedRecords.Count, fullPath);

            exportSucceeded = true;
            exportMessage = $"Exported {allCompletedRecords.Count} sessions to {fullPath}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export parking report");
            exportSucceeded = false;
            exportMessage = $"Export failed: {ex.Message}";
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private async Task ExportByVehicleSummary()
    {
        if (summary.CompletedCount == 0 || isExporting)
        {
            return;
        }

        isExporting = true;
        exportMessage = null;
        StateHasChanged();

        try
        {
            // Request all grouped vehicle summaries in one call by using a large page size.
            var grouped = await RecordService.GetCompletedRecordsGroupedByVehiclePageAsync(1, int.MaxValue);
            var groups = grouped.Items;
            var csv = BuildVehicleGroupedCsv(groups);
            var fileName = $"SmartPark-Report-ByVehicle-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
            var directory = ResolveExportDirectory();
            Directory.CreateDirectory(directory);
            var fullPath = Path.Combine(directory, fileName);

            await File.WriteAllTextAsync(fullPath, csv, new UTF8Encoding(encoderShouldEmitUTF8Identifier: true));

            Logger.LogInformation("Exported vehicle-summary report ({Count} rows) to {Path}", groups.Count, fullPath);

            exportSucceeded = true;
            exportMessage = $"Exported {groups.Count} vehicle summaries to {fullPath}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export vehicle-summary report");
            exportSucceeded = false;
            exportMessage = $"Export failed: {ex.Message}";
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private static string BuildVehicleGroupedCsv(IReadOnlyList<VehicleGroupedRecords> groups)
    {
        var sb = new StringBuilder();
        sb.AppendLine("VehicleNumber,OwnerName,TotalSessions,CompletedSessions,ActiveSessions,TotalDurationHours,TotalDurationText,AvgDurationText,LastSeen");

        for (var i = 0; i < groups.Count; i++)
        {
            var g = groups[i];
            var totalHours = g.TotalDuration.TotalHours.ToString("F2", CultureInfo.InvariantCulture);
            var lastSeen = g.LastSeen.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);

            sb.Append(EscapeCsv(g.VehicleNumber)).Append(',')
              .Append(EscapeCsv(g.OwnerName)).Append(',')
              .Append(g.TotalSessions).Append(',')
              .Append(g.CompletedSessions).Append(',')
              .Append(g.ActiveSessions).Append(',')
              .Append(totalHours).Append(',')
              .Append(EscapeCsv(FormatDuration(g.TotalDuration))).Append(',')
              .Append(EscapeCsv(FormatDuration(g.AverageDuration))).Append(',')
              .Append(EscapeCsv(lastSeen))
              .AppendLine();
        }

        return sb.ToString();
    }

    private static string BuildCsv(IReadOnlyList<ParkingRecord> records)
    {
        var sb = new StringBuilder();
        sb.AppendLine("#,VehicleNumber,OwnerName,SlotNumber,EntryTime,ExitTime,DurationHours,DurationText");

        for (var i = 0; i < records.Count; i++)
        {
            var r = records[i];
            var entry = r.EntryTime.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
            var exit = r.ExitTime?.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) ?? string.Empty;
            var durationHours = r.Duration.HasValue
                ? r.Duration.Value.TotalHours.ToString("F2", CultureInfo.InvariantCulture)
                : string.Empty;

            sb.Append(i + 1).Append(',')
              .Append(EscapeCsv(r.VehicleNumber)).Append(',')
              .Append(EscapeCsv(r.OwnerName)).Append(',')
              .Append(EscapeCsv(r.ParkingSlot?.SlotNumber ?? string.Empty)).Append(',')
              .Append(EscapeCsv(entry)).Append(',')
              .Append(EscapeCsv(exit)).Append(',')
              .Append(durationHours).Append(',')
              .Append(EscapeCsv(FormatDuration(r.Duration)))
              .AppendLine();
        }

        return sb.ToString();
    }

    private static string EscapeCsv(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return string.Empty;
        }

        var needsQuoting = value.IndexOfAny(new[] { ',', '"', '\r', '\n' }) >= 0;
        var escaped = value.Replace("\"", "\"\"");
        return needsQuoting ? $"\"{escaped}\"" : escaped;
    }

    private static string ResolveExportDirectory()
    {
        // Use the MAUI per-app data directory; it is writable in MacCatalyst's sandboxed container.
        try
        {
            var appData = Microsoft.Maui.Storage.FileSystem.Current.AppDataDirectory;
            if (!string.IsNullOrWhiteSpace(appData))
            {
                return Path.Combine(appData, "Reports");
            }
        }
        catch
        {
            // FileSystem may be unavailable in non-MAUI hosts (e.g. unit tests); fall through.
        }

        var documents = Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments);
        return Path.Combine(documents, "SmartPark", "Reports");
    }

    private static string FormatDuration(TimeSpan? duration)
    {
        if (duration == null)
        {
            return "-";
        }

        return FormatDuration(duration.Value);
    }

    private static string FormatDuration(TimeSpan duration)
    {
        return duration.TotalHours >= 24
            ? $"{(int)duration.TotalDays}d {duration.Hours}h {duration.Minutes}m"
            : $"{duration.Hours}h {duration.Minutes}m";
    }
}
