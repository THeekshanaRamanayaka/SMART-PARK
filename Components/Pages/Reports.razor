@page "/reports"
@using System.Globalization
@using System.IO
@using System.Text
@using Microsoft.Extensions.Logging
@using SmartPark.Services
@using SmartPark.Models
@inject ParkingRecordService RecordService
@inject ILogger<Reports> Logger

<PageTitle>Parking Reports - SmartPark</PageTitle>

<div class="page-header">
    <div>
        <div class="page-eyebrow">
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Small" />
            Insights
        </div>
        <h1 class="page-title">Parking reports</h1>
        <p class="page-subtitle">Review completed sessions with clean operational metrics and export-ready detail.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-success" @onclick="ExportReport"
                disabled="@(completedRecords.Count == 0 || isExporting)">
            <MudIcon Icon="@Icons.Material.Filled.IosShare" Size="Size.Small" />
            @(isExporting ? "Exporting..." : "Export CSV")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(exportMessage))
{
    <div class="alert @(exportSucceeded ? "alert-success" : "alert-danger") mb-3" role="alert">
        <MudIcon Icon="@(exportSucceeded ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.ErrorOutline)"
                 Size="Size.Small" />
        <span class="ms-2">@exportMessage</span>
    </div>
}

<div class="grid-3 mb-4">
    <div class="stats-card primary">
        <div class="stats-top">
            <div class="stats-label">Completed Sessions</div>
            <div class="stats-icon">
                <MudIcon Icon="@Icons.Material.Filled.TaskAlt" />
            </div>
        </div>
        <div class="stats-number">@completedRecords.Count</div>
        <div class="stats-trend">Total recorded exits</div>
    </div>

    <div class="stats-card success">
        <div class="stats-top">
            <div class="stats-label">Average Duration</div>
            <div class="stats-icon">
                <MudIcon Icon="@Icons.Material.Filled.Timer" />
            </div>
        </div>
        <div class="stats-number">@AverageDurationText</div>
        <div class="stats-trend">Across completed sessions</div>
    </div>

    <div class="stats-card info">
        <div class="stats-top">
            <div class="stats-label">Total Duration</div>
            <div class="stats-icon">
                <MudIcon Icon="@Icons.Material.Filled.QueryStats" />
            </div>
        </div>
        <div class="stats-number">@TotalDurationText</div>
        <div class="stats-trend">Accumulated parking time</div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="panel-heading">
            <div>
                <h2 class="section-title">Completed parking sessions</h2>
                <div class="muted-text">Only sessions with entry and exit times are included.</div>
            </div>
            <span class="badge bg-success">@completedRecords.Count completed</span>
        </div>

        @if (completedRecords.Count == 0)
        {
            <div class="empty-state">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Color="Color.Primary" Size="Size.Large" />
                <strong>No completed parking sessions found</strong>
                <p>Reports populate once vehicles are checked out.</p>
            </div>
        }
        else
        {
            <div class="table-shell">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Vehicle Number</th>
                                <th>Owner Name</th>
                                <th>Slot Number</th>
                                <th>Entry Time</th>
                                <th>Exit Time</th>
                                <th>Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < completedRecords.Count; i++)
                            {
                                var record = completedRecords[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td><span class="vehicle-plate">@record.VehicleNumber</span></td>
                                    <td>@record.OwnerName</td>
                                    <td><span class="badge bg-primary">Slot @record.ParkingSlot?.SlotNumber</span></td>
                                    <td>@record.EntryTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@record.ExitTime?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@FormatDuration(record.Duration)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<ParkingRecord> completedRecords = new();
    private bool isExporting;
    private bool exportSucceeded;
    private string? exportMessage;

    private TimeSpan TotalDuration => completedRecords
        .Where(record => record.Duration.HasValue)
        .Aggregate(TimeSpan.Zero, (total, record) => total + record.Duration!.Value);

    private string TotalDurationText => completedRecords.Count == 0 ? "0h" : FormatDuration(TotalDuration);

    private string AverageDurationText
    {
        get
        {
            var recordsWithDuration = completedRecords.Where(record => record.Duration.HasValue).ToList();
            if (recordsWithDuration.Count == 0)
            {
                return "0h";
            }

            var averageTicks = (long)recordsWithDuration.Average(record => record.Duration!.Value.Ticks);
            return FormatDuration(TimeSpan.FromTicks(averageTicks));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadCompletedRecords();
        }
        catch (Exception ex)
        {
            completedRecords = new();
            Console.WriteLine($"Failed to load reports: {ex.Message}");
        }
    }

    private async Task LoadCompletedRecords()
    {
        completedRecords = await RecordService.GetCompletedRecordsAsync();
    }

    private async Task ExportReport()
    {
        if (completedRecords.Count == 0 || isExporting)
        {
            return;
        }

        isExporting = true;
        exportMessage = null;
        StateHasChanged();

        try
        {
            var csv = BuildCsv(completedRecords);
            var fileName = $"SmartPark-Report-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
            var directory = ResolveExportDirectory();
            Directory.CreateDirectory(directory);
            var fullPath = Path.Combine(directory, fileName);

            // UTF-8 with BOM so Excel on Windows opens it cleanly.
            await File.WriteAllTextAsync(fullPath, csv, new UTF8Encoding(encoderShouldEmitUTF8Identifier: true));

            Logger.LogInformation("Exported parking report ({Count} rows) to {Path}", completedRecords.Count, fullPath);

            exportSucceeded = true;
            exportMessage = $"Exported {completedRecords.Count} sessions to {fullPath}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export parking report");
            exportSucceeded = false;
            exportMessage = $"Export failed: {ex.Message}";
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private static string BuildCsv(IReadOnlyList<ParkingRecord> records)
    {
        var sb = new StringBuilder();
        sb.AppendLine("#,VehicleNumber,OwnerName,SlotNumber,EntryTime,ExitTime,DurationHours,DurationText");

        for (var i = 0; i < records.Count; i++)
        {
            var r = records[i];
            var entry = r.EntryTime.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
            var exit = r.ExitTime?.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) ?? string.Empty;
            var durationHours = r.Duration.HasValue
                ? r.Duration.Value.TotalHours.ToString("F2", CultureInfo.InvariantCulture)
                : string.Empty;

            sb.Append(i + 1).Append(',')
              .Append(EscapeCsv(r.VehicleNumber)).Append(',')
              .Append(EscapeCsv(r.OwnerName)).Append(',')
              .Append(EscapeCsv(r.ParkingSlot?.SlotNumber ?? string.Empty)).Append(',')
              .Append(EscapeCsv(entry)).Append(',')
              .Append(EscapeCsv(exit)).Append(',')
              .Append(durationHours).Append(',')
              .Append(EscapeCsv(FormatDuration(r.Duration)))
              .AppendLine();
        }

        return sb.ToString();
    }

    private static string EscapeCsv(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return string.Empty;
        }

        var needsQuoting = value.IndexOfAny(new[] { ',', '"', '\r', '\n' }) >= 0;
        var escaped = value.Replace("\"", "\"\"");
        return needsQuoting ? $"\"{escaped}\"" : escaped;
    }

    private static string ResolveExportDirectory()
    {
        // Use the MAUI per-app data directory; it is writable in MacCatalyst's sandboxed container.
        try
        {
            var appData = Microsoft.Maui.Storage.FileSystem.Current.AppDataDirectory;
            if (!string.IsNullOrWhiteSpace(appData))
            {
                return Path.Combine(appData, "Reports");
            }
        }
        catch
        {
            // FileSystem may be unavailable in non-MAUI hosts (e.g. unit tests); fall through.
        }

        var documents = Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments);
        return Path.Combine(documents, "SmartPark", "Reports");
    }

    private static string FormatDuration(TimeSpan? duration)
    {
        if (duration == null)
        {
            return "-";
        }

        return FormatDuration(duration.Value);
    }

    private static string FormatDuration(TimeSpan duration)
    {
        return duration.TotalHours >= 24
            ? $"{(int)duration.TotalDays}d {duration.Hours}h {duration.Minutes}m"
            : $"{duration.Hours}h {duration.Minutes}m";
    }
}
