@page "/entry"
@using SmartPark.Services
@using SmartPark.Models
@inject ParkingSlotService SlotService
@inject ParkingRecordService RecordService

<PageTitle>Vehicle Entry - SmartPark</PageTitle>

<div class="page-header">
    <div>
        <div class="page-eyebrow">
            <MudIcon Icon="@Icons.Material.Filled.AddRoad" Size="Size.Small" />
            Gate operation
        </div>
        <h1 class="page-title">Register vehicle entry</h1>
        <p class="page-subtitle">Capture the vehicle, review previous visits, and assign the next available parking slot.</p>
    </div>
    <div class="page-actions">
        <span class="status-pill"><span class="status-dot"></span>@availableSlots slots available</span>
    </div>
</div>

<div class="split-grid">
    <div class="card">
        <div class="card-body">
            <div class="panel-heading">
                <div>
                    <h2 class="section-title">Entry details</h2>
                    <div class="muted-text">Vehicle and owner information</div>
                </div>
                <span class="badge bg-primary">Gate In</span>
            </div>

            <div class="mb-3">
                <label class="form-label">Vehicle Number</label>
                <MudAutocomplete T="VehicleSummary"
                                 Value="selectedVehicle"
                                 ValueChanged="OnVehicleSelected"
                                 SearchFunc="SearchVehiclesAsync"
                                 Text="@vehicleNumber"
                                 TextChanged="OnVehicleTextChanged"
                                 ToStringFunc="@(v => v?.VehicleNumber ?? string.Empty)"
                                 Placeholder="Search or type a plate (e.g., ABC-1234)"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Clearable="true"
                                 CoerceText="false"
                                 CoerceValue="false"
                                 ResetValueOnEmptyText="true"
                                 DebounceInterval="150"
                                 MinCharacters="0"
                                 Dense="true"
                                 AdornmentIcon="@Icons.Material.Filled.DirectionsCar"
                                 Adornment="Adornment.Start">
                    <ItemTemplate Context="vehicle">
                        <div class="d-flex flex-column">
                            <strong>@vehicle.VehicleNumber</strong>
                            <small class="muted-text">@vehicle.OwnerName · Last seen @vehicle.LastSeen.ToString("yyyy-MM-dd")</small>
                        </div>
                    </ItemTemplate>
                    <NoItemsTemplate>
                        <div class="px-2 py-1">
                            <div><strong>New vehicle</strong></div>
                            <small class="muted-text">Type the plate and owner name to register it.</small>
                        </div>
                    </NoItemsTemplate>
                </MudAutocomplete>
                @if (selectedVehicle is not null)
                {
                    <small class="muted-text">Matched existing record — owner auto-filled.</small>
                }
                else if (!string.IsNullOrWhiteSpace(vehicleNumber))
                {
                    <small class="muted-text">New vehicle — will be registered on entry.</small>
                }
            </div>

            <div class="mb-3 d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadVehicleHistory" disabled="@string.IsNullOrWhiteSpace(vehicleNumber)">
                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
                    View Past Details
                </button>
            </div>

            @if (!string.IsNullOrEmpty(historyMessage))
            {
                <div class="alert alert-info">@historyMessage</div>
            }

            @if (vehicleHistory.Count > 0)
            {
                <div class="table-shell mb-3">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Entry Time</th>
                                    <th>Exit Time</th>
                                    <th>Slot</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in vehicleHistory)
                                {
                                    <tr>
                                        <td>@record.EntryTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@(record.ExitTime?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                        <td><span class="badge bg-primary">@record.ParkingSlot?.SlotNumber</span></td>
                                        <td>@FormatDuration(record.Duration)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Owner Name</label>
                <input type="text" class="form-control" @bind="ownerName" placeholder="Enter owner name" />
            </div>

            <div class="mb-3">
                <label class="form-label">Parking Slot</label>
                <MudSelect T="int"
                           Value="selectedSlotId"
                           ValueChanged="OnSlotChanged"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Disabled="@(availableSlots == 0)"
                           AdornmentIcon="@Icons.Material.Filled.LocalParking"
                           Adornment="Adornment.Start">
                    <MudSelectItem T="int" Value="0">Auto-assign next free slot</MudSelectItem>
                    @foreach (var slot in availableSlotList)
                    {
                        <MudSelectItem T="int" Value="slot.Id">Slot @slot.SlotNumber</MudSelectItem>
                    }
                </MudSelect>
                <small class="muted-text">@(availableSlots == 0 ? "No slots available right now." : $"{availableSlots} slot(s) free.")</small>
            </div>

            <button class="btn btn-primary" @onclick="RegisterEntry" disabled="@(availableSlots == 0)">
                <MudIcon Icon="@Icons.Material.Filled.HowToReg" Size="Size.Small" />
                Register Entry
            </button>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert @(isSuccess ? "alert-success" : "alert-danger") mt-3">@message</div>
            }
        </div>
    </div>

    <div class="content-grid">
        <div class="stats-card success">
            <div class="stats-top">
                <div class="stats-label">Available Slots</div>
                <div class="stats-icon"><MudIcon Icon="@Icons.Material.Filled.EventAvailable" /></div>
            </div>
            <div class="stats-number">@availableSlots</div>
            <div class="stats-trend">Ready for the next arrival</div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="panel-heading">
                    <div>
                        <h2 class="section-title">Entry checklist</h2>
                        <div class="muted-text">Keep the gate flow consistent</div>
                    </div>
                </div>
                <div class="list-group">
                    <div class="list-group-item">
                        <span>Confirm vehicle number</span>
                        <span class="badge bg-primary">Plate</span>
                    </div>
                    <div class="list-group-item">
                        <span>Verify owner name</span>
                        <span class="badge bg-secondary">Owner</span>
                    </div>
                    <div class="list-group-item">
                        <span>Assign open slot</span>
                        <span class="badge bg-success">Auto</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string vehicleNumber = string.Empty;
    private string ownerName = string.Empty;
    private int availableSlots = 0;
    private string message = string.Empty;
    private bool isSuccess = false;
    private List<ParkingRecord> vehicleHistory = new();
    private string historyMessage = string.Empty;

    private List<VehicleSummary> knownVehicles = new();
    private VehicleSummary? selectedVehicle;
    private List<ParkingSlot> availableSlotList = new();
    private int selectedSlotId = 0; // 0 = auto-assign

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAvailableSlots();
            knownVehicles = await RecordService.GetKnownVehiclesAsync();
        }
        catch (Exception ex)
        {
            message = $"Failed to initialise entry screen: {ex.Message}";
            availableSlots = 0;
        }
    }

    private async Task LoadAvailableSlots()
    {
        availableSlotList = await SlotService.GetAvailableSlotsAsync();
        availableSlots = availableSlotList.Count;

        // Reset slot choice if it's no longer available.
        if (selectedSlotId != 0 && !availableSlotList.Any(s => s.Id == selectedSlotId))
        {
            selectedSlotId = 0;
        }
    }

    private Task<IEnumerable<VehicleSummary>> SearchVehiclesAsync(string value, CancellationToken token)
    {
        IEnumerable<VehicleSummary> results = knownVehicles;
        if (!string.IsNullOrWhiteSpace(value))
        {
            results = knownVehicles.Where(v =>
                v.VehicleNumber.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                v.OwnerName.Contains(value, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(results.Take(20));
    }

    private void OnVehicleSelected(VehicleSummary? vehicle)
    {
        selectedVehicle = vehicle;
        if (vehicle is not null)
        {
            vehicleNumber = vehicle.VehicleNumber;
            ownerName = vehicle.OwnerName;
        }
    }

    private void OnVehicleTextChanged(string value)
    {
        vehicleNumber = value ?? string.Empty;

        // If the typed text no longer matches the selected vehicle, treat it as a new entry
        // and clear the auto-filled owner so the operator types it explicitly.
        if (selectedVehicle is not null &&
            !string.Equals(selectedVehicle.VehicleNumber, vehicleNumber, StringComparison.OrdinalIgnoreCase))
        {
            selectedVehicle = null;
            ownerName = string.Empty;
        }
    }

    private void OnSlotChanged(int slotId)
    {
        selectedSlotId = slotId;
    }

    private async Task RegisterEntry()
    {
        if (string.IsNullOrWhiteSpace(vehicleNumber) || string.IsNullOrWhiteSpace(ownerName))
        {
            message = "Please fill in all fields";
            isSuccess = false;
            return;
        }

        int? slotIdToUse = selectedSlotId == 0 ? (int?)null : selectedSlotId;
        var success = await RecordService.RecordVehicleEntryAsync(vehicleNumber.Trim(), ownerName.Trim(), slotIdToUse);

        if (success)
        {
            message = $"Vehicle {vehicleNumber} registered successfully!";
            isSuccess = true;
            vehicleNumber = string.Empty;
            ownerName = string.Empty;
            selectedVehicle = null;
            selectedSlotId = 0;
            vehicleHistory = new();
            historyMessage = string.Empty;
            await LoadAvailableSlots();
            knownVehicles = await RecordService.GetKnownVehiclesAsync();
        }
        else
        {
            message = slotIdToUse.HasValue
                ? "Failed to register vehicle. The selected slot is no longer available."
                : "Failed to register vehicle. No available slots.";
            isSuccess = false;
            await LoadAvailableSlots();
        }
    }

    private async Task LoadVehicleHistory()
    {
        var searchNumber = vehicleNumber.Trim();
        if (string.IsNullOrWhiteSpace(searchNumber))
        {
            historyMessage = "Enter a vehicle number to load past details.";
            vehicleHistory = new();
            return;
        }

        vehicleHistory = await RecordService.GetVehicleHistoryAsync(searchNumber);
        historyMessage = vehicleHistory.Count == 0
            ? $"No past completed records found for {searchNumber}."
            : $"Showing {vehicleHistory.Count} past record(s) for {searchNumber}.";
    }

    private static string FormatDuration(TimeSpan? duration)
    {
        return duration == null ? "-" : $"{duration.Value.Hours}h {duration.Value.Minutes}m";
    }
}
