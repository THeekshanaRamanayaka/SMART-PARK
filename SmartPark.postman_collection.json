{
  "info": {
    "name": "SmartPark Local API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for SmartPark local test API (default base_url: http://127.0.0.1:5099)"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health"
        }
      }
    },
    {
      "name": "List slots",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/slots"
        }
      }
    },
    {
      "name": "Available slots count",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/slots/available-count"
        }
      }
    },
    {
      "name": "Create slot",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"slotNumber\":\"A-01\",\"isOccupied\":false}"
        },
        "url": {
          "raw": "{{base_url}}/api/slots"
        }
      }
    },
    {
      "name": "Get all records",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/records"
        }
      }
    },
    {
      "name": "Get active records",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/records/active"
        }
      }
    },
    {
      "name": "Record entry",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"vehicleNumber\":\"ABC-1234\",\"ownerName\":\"Test Driver\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/records/entry"
        }
      }
    },
    {
      "name": "Record exit (by record id)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/records/1/exit"
        }
      }
    },
    {
      "name": "Search records",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/records/search?term=ABC"
        }
      }
    },
    {
      "name": "Vehicle history",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/records/history/ABC-1234"
        }
      }
    }
  ]
}